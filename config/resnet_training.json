{
    "target_well": 4,
    "training_wells": [
        1,
        2,
        3,
        5,
        6,
        7,
        8
    ],
    "include_augmented_records": true,
    "target_columns": [
        "sandstone_sludge",
        "siltstone_sludge",
        "argillite_sludge",
        "radiolarite_sludge",
        "coal_sludge",
        "limestone_sludge",
        "clay_sludge",
        "other_sludge"
    ],
    "output": {
        "output_base_folder": "output",
        "output_gb_sub_folder": "gb",
        "output_resnet_sub_folder": "resnet",
        "output_runs_prefix_for_saving": "runs",
        "output_tuning_prefix_for_saving": "tuning"
    },
    "data_loader": {
        "num_workers": 13
    },
    "tuning_params": {
        "study_name": "resnet_target_well_v1",
        "total_trials": 5,
        "smoke_mode": false,
        "pruner_n_startup_trials": 5,
        "pruner_n_warmup_steps": 3
    },
    "search_params": {
        "learning_rate": {
            "type": "float",
            "low": 0.00001,
            "high": 0.001,
            "log": true
        },
        "weight_decay": {
            "type": "float",
            "low": 0.000001,
            "high": 0.01,
            "log": true
        },
        "head_hidden_size": {
            "type": "categorical",
            "choices": [
                256,
                512,
                1024
            ]
        },
        "dropout": {
            "type": "float",
            "low": 0.1,
            "high": 0.5,
            "step": 0.1
        },
        "huber_delta": {
            "type": "categorical",
            "choices": [
                0.5,
                1.0,
                2.0,
                5.0
            ]
        }
    },
    "initial_hyper_params": {
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "head_hidden_size": 512,
        "dropout": 0.3,
        "huber_delta": 1.0
    },
    "fixed_hyper_params": {
        "model_name": "resnet50d",
        "pretrained": true,
        "optimizer": "AdamW",
        "input_size": 512,
        "batch_size": 16,
        "accumulate_grad_batches": 4,
        "max_epochs": 15,
        "early_stop_patience": 6,
        "lr_factor": 0.5,
        "lr_patience": 3,
        "random_seed": 42
    },
    "final_training": {
        "save_predictions": true
    }
}
