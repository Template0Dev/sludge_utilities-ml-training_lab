{
    "target_well": 4,
    "training_wells": [
        1,
        2,
        3,
        5,
        6,
        7,
        8
    ],
    "include_augmented_records": true,
    "target_columns": [
        "sandstone_sludge",
        "siltstone_sludge",
        "argillite_sludge"
    ],
    "output": {
        "output_base_folder": "output",
        "output_gb_sub_folder": "gb",
        "output_resnet_sub_folder": "resnet",
        "output_runs_prefix_for_saving": "runs",
        "output_tuning_prefix_for_saving": "tuning"
    },
    "features": {
        "base_columns": [
            
        ],
        "should_use_sludge_embeddings": true,
        "should_use_lba_embeddings": false,
        "sludge_embedding_column": "sludge_dinov3_emb",
        "lba_embedding_column": "lba_dinov3_emb",
        "embedding_join_keys": [
            "well_id",
            "interval_start",
            "interval_end",
            "sludge_image_path",
            "lba_image_path",
            "is_augmented"
        ]
    },
    "tuning_params": {
        "study_name": "catboost_target_well_v1",
        "total_trials": 50,
        "smoke_mode": false,
        "pruner_n_startup_trials": 5,
        "pruner_n_warmup_steps": 0
    },
    "search_params": {
        "pca_components": {
            "type": "categorical",
            "choices": [
                16,
                32,
                64,
                128
            ]
        },
        "learning_rate": {
            "type": "float",
            "low": 0.005,
            "high": 0.1,
            "log": true
        },
        "depth": {
            "type": "int",
            "low": 4,
            "high": 10
        },
        "l2_leaf_reg": {
            "type": "float",
            "low": 1.0,
            "high": 30.0,
            "log": true
        },
        "subsample": {
            "type": "float",
            "low": 0.5,
            "high": 1.0
        },
        "rsm": {
            "type": "float",
            "low": 0.5,
            "high": 1.0
        },
        "random_strength": {
            "type": "float",
            "low": 0.001,
            "high": 10.0,
            "log": true
        }
    },
    "initial_hyper_params": {
        "pca_components": 32,
        "learning_rate": 0.015,
        "depth": 5,
        "l2_leaf_reg": 10.0,
        "subsample": 0.8,
        "rsm": 0.7,
        "random_strength": 1.0
    },
    "fixed_hyper_params": {
        "iterations": 5000,
        "bootstrap_type": "Bernoulli",
        "loss_function": "MultiRMSE",
        "eval_metric": "MultiRMSE",
        "early_stopping_rounds": 200,
        "random_seed": 42,
        "task_type": "CPU"
    },
    "final_training": {
        "save_predictions": true
    }
}
