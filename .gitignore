# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data directories (ignore content, preserve folder via .gitkeep)
data/images*/*
!data/images*/.gitkeep
data/meta*/processed/gb/*
!data/meta*/processed/gb/.gitkeep
data/meta*/interim/*
!data/meta*/interim/.gitkeep
data/meta*/raw/*
!data/meta*/raw/.gitkeep

# Input directory
input/gb/*
!input/gb/.gitkeep
input/resnet/*
!input/resnet/.gitkeep

# Output directories (ignore content, preserve folder via .gitkeep)
output/gb/**/*
output/resnet/**/*
## Output subfolders preserve ('cause packaged results will be saved in there)
!output/**/.gitkeep

catboost_info/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
