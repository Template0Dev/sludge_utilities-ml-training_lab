# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data directories (ignore content, preserve folder via .gitkeep)
data/images/*
!data/images/.gitkeep
data/interim/gb/*
!data/interim/gb/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Input directory
input/gb/*
!input/gb/.gitkeep
input/resnet/*
!input/resnet/.gitkeep

# Output directories (ignore content, preserve folder via .gitkeep)
output/**/predictions/*
!output/**/predictions/.gitkeep
output/**/models/*
!output/**/models/.gitkeep
output/**/logs/*
!output/**/logs/.gitkeep

catboost_info/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
